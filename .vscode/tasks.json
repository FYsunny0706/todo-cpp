{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "Auto: app/main.cpp + all src/*.cpp -> build/todo.exe   [Ctrl+Shift+B]",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17", "-Wall", "-Wextra", "-g",
                "-Iinclude",
                "app/main.cpp", "src/*.cpp",
                "-o", "build/todo.exe"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build-test",
            "detail": "Auto: current test file + all src/*.cpp -> build/<file>.exe",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17", "-Wall", "-Wextra", "-g",
                "-Iinclude",
                "${file}", "src/*.cpp",
                "-o", "build/${fileBasenameNoExtension}.exe"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": "test"
        }
    ]
}